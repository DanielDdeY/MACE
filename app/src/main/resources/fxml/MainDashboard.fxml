<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mace.presentation.view.MainDashboardController"
            stylesheets="@../styles/dark-theme.css"
            styleClass="root-pane">

    <!-- ==================== MENU LATERAL ==================== -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="210" spacing="6">
            <padding>
                <Insets top="20" right="12" bottom="20" left="12" />
            </padding>

            <Label text="MACE" styleClass="sidebar-brand" />
            <Label text="Monitor de sistema" styleClass="sidebar-subtitle" />

            <VBox spacing="4" styleClass="sidebar-nav">
                <padding>
                    <Insets top="24" />
                </padding>
                <ToggleButton fx:id="navCpu" text="CPU" styleClass="nav-button" maxWidth="Infinity" />
                <ToggleButton fx:id="navGpu" text="GPU" styleClass="nav-button" maxWidth="Infinity" />
                <ToggleButton fx:id="navHistorial" text="Historial" styleClass="nav-button" maxWidth="Infinity" />
                <ToggleButton fx:id="navProcesos" text="Procesos" styleClass="nav-button" maxWidth="Infinity" />
                <ToggleButton fx:id="navRam" text="RAM" styleClass="nav-button" maxWidth="Infinity" />
            </VBox>
        </VBox>
    </left>

    <!-- ==================== CONTENIDO ==================== -->
    <center>
        <StackPane styleClass="content-area">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20" />
            </padding>

            <!-- ==================== APARTADO: CPU ==================== -->
            <VBox fx:id="paneCpu" spacing="16" styleClass="section-pane">
                <Label text="CPU" styleClass="section-title" />
                <Label text="Temperatura y consumo del procesador en tiempo real" styleClass="section-subtitle" />
                <HBox fx:id="cpuGaugesBox" spacing="20" styleClass="gauges-box" />

                <HBox spacing="12" styleClass="stats-row">
                    <VBox styleClass="stat-card">
                        <Label text="Estado" styleClass="stat-title" />
                        <Label fx:id="cpuStatusLabel" text="--" styleClass="stat-value" />
                    </VBox>
                    <VBox styleClass="stat-card">
                        <Label text="Máximo (30s)" styleClass="stat-title" />
                        <Label fx:id="cpuMaxLabel" text="--" styleClass="stat-value" />
                    </VBox>
                    <VBox styleClass="stat-card">
                        <Label text="Promedio (30s)" styleClass="stat-title" />
                        <Label fx:id="cpuAvgLabel" text="--" styleClass="stat-value" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- ==================== APARTADO: GPU ==================== -->
            <VBox fx:id="paneGpu" spacing="16" styleClass="section-pane">
                <Label text="GPU" styleClass="section-title" />
                <Label text="Temperatura y consumo de la tarjeta gráfica en tiempo real" styleClass="section-subtitle" />
                <HBox fx:id="gpuGaugesBox" spacing="20" styleClass="gauges-box" />

                <HBox spacing="12" styleClass="stats-row">
                    <VBox styleClass="stat-card">
                        <Label text="Estado" styleClass="stat-title" />
                        <Label fx:id="gpuStatusLabel" text="--" styleClass="stat-value" />
                    </VBox>
                    <VBox styleClass="stat-card">
                        <Label text="Ventilador" styleClass="stat-title" />
                        <Label fx:id="gpuFanLabel" text="--" styleClass="stat-value" />
                    </VBox>
                    <VBox styleClass="stat-card">
                        <Label text="Disponibilidad" styleClass="stat-title" />
                        <Label fx:id="gpuAvailableLabel" text="--" styleClass="stat-value" />
                    </VBox>
                    <VBox styleClass="stat-card">
                        <Label text="Máximo (30s)" styleClass="stat-title" />
                        <Label fx:id="gpuMaxLabel" text="--" styleClass="stat-value" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- ==================== APARTADO: HISTORIAL (graficos separados) ==================== -->
            <VBox fx:id="paneHistorial" spacing="12" styleClass="section-pane">
                <Label text="Historial de temperatura" styleClass="section-title" />
                <Label text="Evolución de los últimos 30 segundos, por componente" styleClass="section-subtitle" />

                <VBox styleClass="chart-card" VBox.vgrow="ALWAYS">
                    <Label text="Temperatura CPU" styleClass="chart-card-title" />
                    <LineChart fx:id="cpuTempChart" legendVisible="false" animated="false"
                               createSymbols="false" VBox.vgrow="ALWAYS">
                        <xAxis>
                            <NumberAxis label="Tiempo (s)" forceZeroInRange="false" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="°C" lowerBound="0" upperBound="100" tickUnit="20" autoRanging="false" />
                        </yAxis>
                    </LineChart>
                </VBox>

                <VBox styleClass="chart-card" VBox.vgrow="ALWAYS">
                    <Label text="Temperatura GPU" styleClass="chart-card-title" />
                    <LineChart fx:id="gpuTempChart" legendVisible="false" animated="false"
                               createSymbols="false" VBox.vgrow="ALWAYS">
                        <xAxis>
                            <NumberAxis label="Tiempo (s)" forceZeroInRange="false" />
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="°C" lowerBound="0" upperBound="100" tickUnit="20" autoRanging="false" />
                        </yAxis>
                    </LineChart>
                </VBox>
            </VBox>

            <!-- ==================== APARTADO: PROCESOS (sin boton de accion) ==================== -->
            <VBox fx:id="paneProcesos" spacing="12" styleClass="section-pane">
                <Label text="Procesos activos" styleClass="section-title" />
                <Label text="Listado de procesos de usuario en ejecución" styleClass="section-subtitle" />

                <TextField fx:id="searchProcesos" promptText="Buscar por nombre o PID..." styleClass="search-field" />

                <TableView fx:id="tablaProcesos" styleClass="process-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="procPidColumn" text="PID" prefWidth="90" />
                        <TableColumn fx:id="procNombreColumn" text="Proceso" prefWidth="240" />
                        <TableColumn fx:id="procRutaColumn" text="Ruta del ejecutable" prefWidth="420" />
                    </columns>
                </TableView>
            </VBox>

            <!-- ==================== APARTADO: RAM (pie + lista + boton Finalizar) ==================== -->
            <VBox fx:id="paneRam" spacing="12" styleClass="section-pane">
                <Label text="Memoria RAM" styleClass="section-title" />
                <Label text="Distribución de memoria por proceso y gestión manual" styleClass="section-subtitle" />

                <HBox spacing="12" styleClass="ram-top">
                    <VBox styleClass="chart-card" prefWidth="380">
                        <Label text="Memoria por proceso" styleClass="chart-card-title" />
                        <PieChart fx:id="memoryPieChart" legendVisible="true" labelsVisible="false"
                                  VBox.vgrow="ALWAYS" />
                    </VBox>

                    <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" spacing="8">
                        <Label text="Resumen" styleClass="chart-card-title" />
                        <Label fx:id="ramTotalLabel" text="--" styleClass="ram-total-value" />
                        <Label text="Memoria total usada por los procesos listados" styleClass="section-subtitle" />
                        <Label fx:id="ramCountLabel" text="--" styleClass="ram-count-value" />
                        <Label text="Procesos en seguimiento" styleClass="section-subtitle" />
                    </VBox>
                </HBox>

                <TextField fx:id="searchRam" promptText="Buscar por nombre o PID..." styleClass="search-field" />

                <TableView fx:id="tablaRam" styleClass="process-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="ramPidColumn" text="PID" prefWidth="80" />
                        <TableColumn fx:id="ramNombreColumn" text="Proceso" prefWidth="220" />
                        <TableColumn fx:id="ramMemoriaColumn" text="Memoria (Working Set)" prefWidth="180" />
                        <TableColumn fx:id="ramAccionColumn" text="Acción" prefWidth="180" />
                    </columns>
                </TableView>
            </VBox>

        </StackPane>
    </center>

</BorderPane>