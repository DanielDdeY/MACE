# ==========================================
# 1. Java y Apache Maven (app/)
# ==========================================
app/target/
**/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties
hs_err_pid*
replay_pid*

# ==========================================
# 2. C y CMake / MSVC / Ninja (native/)
# ==========================================
# Carpetas de compilación
native/build/
**/cmake-build-*/
native/out/
# OJO: nunca usar patrones genericos como **/out/ o **/build/ aqui:
# se tragan paquetes Java legitimos como app/src/main/java/com/mace/domain/port/out/

# Archivos de caché y configuración local de CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.ninja
.ninja_deps
.ninja_log

# Objetos y artefactos generados por MSVC
*.obj
*.o
*.ilk
*.pdb
*.exp
*.lib
*.manifest

# Binario nativo generado (debe compilarse vía CMake o CI, no versionarse)
mace_native.dll
**/mace_native.dll

# ==========================================
# 3. Empaquetado y Distribución (packaging/)
# ==========================================
packaging/dist/
packaging/output/
packaging/runtime/
*.msi
*.exe
# Permitir scripts y manifiestos de packaging
!packaging/package-windows.bat
!packaging/app.manifest

# ==========================================
# 4. Entornos de Desarrollo (IDEs)
# ==========================================
# JetBrains (IntelliJ IDEA, CLion)
.idea/
*.iml
*.iws
*.ipr

# Visual Studio / VS Code
.vs/
*.VC.db
*.opendb
.vscode/

# Eclipse
.classpath
.project
.settings/

# ==========================================
# 5. Sistema Operativo y Logs
# ==========================================
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.log

# Local builds, external binary dependencies and package caches (never source namespaces).
*.dll
*.sys
*.nupkg
*.snupkg
.nuget/
.packages/
helper/packages/
**/artifacts/
native/build-*/
packaging/prerequisites/
app/src/main/java/com/mace/infrastructure/nativebridge.zip

# Reglas incorporadas desde main (empaquetado, IDE y entorno local)
/target/
native/dist/
native/bin/
native/build-info.json
native/SHA256SUMS.txt
/build/
/out/
CMakeUserPresets.json
*.msix
*.msixbundle
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.suo
*.user
*.tmp
*.bak
.env
.env.*
!.env.example
!.env.sample
